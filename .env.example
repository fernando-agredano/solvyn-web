# Copy to .env.local and fill in. Never commit real values.

# Supabase (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# At least 16 random characters. Salt for hashing IPs and emails in generation_log.
HASH_SALT=

# Public URL of the site (http://localhost:3000 in development). Inlined at build time.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# AI providers (optional: without them the proposal is generated with rules only)
GEMINI_API_KEY=
GEMINI_MODEL=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=

# Email with Resend (optional: without all three, nothing is sent and the flow works the same)
RESEND_API_KEY=
OWNER_EMAIL=
EMAIL_FROM=

# The only address allowed into /admin. Without it nobody can sign in.
ADMIN_EMAIL=

# Cal.com event link, "username/event-slug" (optional: without it the scheduling screen offers WhatsApp and email)
NEXT_PUBLIC_CAL_LINK=
